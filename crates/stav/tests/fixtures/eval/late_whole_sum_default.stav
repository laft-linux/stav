#! render json toml yaml
type Build =
  | cargo(features: List<Str> = [], bins: List<Str> = [])
  | meson(options: List<Str> = [])

struct Root { key: Str = "x", build: Build = make(self.key) }

fn make(key: Str) -> Build = cargo(features = ["old"], bins = [key])

build cargo { features = ["selected"] }
